# The external HTTPS address of Bucket, without a trailing path.
BUCKET_PUBLIC_URL=https://bucket.example.com

# Mailcow web origin and a READ-WRITE administrator API key.
# Allow Bucket's outbound IP in the key's Mailcow IP restrictions.
BUCKET_MAILCOW_URL=https://mail.example.com
BUCKET_MAILCOW_API_KEY=replace-with-your-mailcow-api-key

# Mailcow IMAP hostname with a trusted TLS certificate. Implicit TLS only.
BUCKET_IMAP_HOST=mail.example.com
BUCKET_IMAP_PORT=993

# Outgoing mail defaults to BUCKET_IMAP_HOST, port 587 with required STARTTLS.
# Override when your SMTP service uses a different hostname or implicit TLS (465).
# BUCKET_SMTP_HOST=mail.example.com
# BUCKET_SMTP_PORT=587
# BUCKET_SMTP_SECURITY=starttls
# BUCKET_SMTP_SECURITY accepts only starttls or tls; plaintext is never allowed.

# Existing, active, locally authenticated Mailcow mailbox. Only this identity is admin.
BUCKET_ADMIN_EMAIL=admin@example.com

# Sessions expire absolutely after this many hours (1–168).
BUCKET_SESSION_HOURS=12

# Default: host reverse proxy only. See README for container-based reverse proxies.
BUCKET_LISTEN_ADDRESS=127.0.0.1
BUCKET_PORT=8080
RUST_LOG=bucket=info

# Optional private CA: mount the CA file read-only using a Compose override.
# BUCKET_CA_CERT=/certs/private-ca.pem
# SSL_CERT_FILE=/certs/combined-ca-bundle.pem
